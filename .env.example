# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/globallogistics
CLIENT_ORIGIN=http://localhost:5173

# Email (SMTP) — optional in dev; leads still stored in MongoDB
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@global-logisticssolution.com

# Default inbox when type-specific routing is unset
INQUIRY_EMAIL_DEFAULT=info@global-logisticssolution.com

# Admin (optional)
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Client (Vite)
VITE_API_URL=http://localhost:5000
