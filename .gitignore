# ═══════════════════════════════════════════════
# SENSITIVE DATA & CREDENTIALS (NEVER COMMIT)
# ═══════════════════════════════════════════════

# Environment files and API secrets
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Private Keys, Certificates, and Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
credentials.json
serviceAccountKey*.json
client_secret*.json

# ═══════════════════════════════════════════════
# LOCAL DATABASE & DATA FILES
# ═══════════════════════════════════════════════

server/data/
server/data/**
**/data/db/
data/
*.wt
WiredTiger*
diagnostic.data/
mongod.lock
*.sqlite
*.sqlite3
*.db

# ═══════════════════════════════════════════════
# USER UPLOADS & RESUMES (CONFIDENTIAL)
# ═══════════════════════════════════════════════

uploads/
**/uploads/*
!**/uploads/.gitignore
client/dist/uploads/

# ═══════════════════════════════════════════════
# DEPENDENCIES & PACKAGES
# ═══════════════════════════════════════════════

node_modules/
*/node_modules/
.pnp
.pnp.js

# ═══════════════════════════════════════════════
# PRODUCTION BUILDS & COMPILER OUTPUT
# ═══════════════════════════════════════════════

dist/
client/dist/
server/dist/
build/
*.tsbuildinfo
.vite/
client/.vite/

# ═══════════════════════════════════════════════
# LOGS & DIAGNOSTICS
# ═══════════════════════════════════════════════

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ═══════════════════════════════════════════════
# OS & SYSTEM METADATA
# ═══════════════════════════════════════════════

.DS_Store
Thumbs.db
*.tmp
.tmp/
Desktop.ini

# ═══════════════════════════════════════════════
# IDE & EDITOR CONFIGURATIONS
# ═══════════════════════════════════════════════

.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
